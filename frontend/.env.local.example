## Local-only Vite env (copy to .env.local)
##
## NOTE: Vite only exposes vars prefixed with VITE_ to the browser bundle.
##
## VITE_API_KEY is dev-only: the app reads it only when `vite` runs (import.meta.env.DEV).
## It is not used or embedded in the production bundle from `make build`.

# Backend proxy target (used by vite dev server)
VITE_BACKEND_URL=http://localhost:8080

# Optional: default API key when running Vite dev server (ignored in production build)
VITE_API_KEY=replace_me

